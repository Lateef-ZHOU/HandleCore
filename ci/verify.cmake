cmake_minimum_required(VERSION 3.28)
# 本地与 Actions 共用入口；只操作指定构建目录，不下载/安装依赖。
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED BUILD_ROOT)
    set(BUILD_ROOT "${source}/build-ci")
endif()
if(NOT DEFINED PROFILES)
    set(PROFILES core serial pcap sim-gimbal sim-card all)
endif()
if(NOT DEFINED CONFIG)
    set(CONFIG Release)
endif()
if(NOT DEFINED PARALLEL)
    set(PARALLEL 4)
endif()

function(run_logged log)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_FILE "${log}" ERROR_FILE "${log}")
    if(NOT result EQUAL 0)
        file(READ "${log}" output)
        message(FATAL_ERROR "${log}: exit ${result}\n${output}")
    endif()
endfunction()

foreach(profile IN LISTS PROFILES)
    if(NOT profile MATCHES "^(core|serial|pcap|sim-gimbal|sim-card|all)$")
        message(FATAL_ERROR "Unknown profile: ${profile}")
    endif()
    set(build "${BUILD_ROOT}/${profile}")
    file(MAKE_DIRECTORY "${build}")
    set(args -S "${source}" -B "${build}" "-DCMAKE_BUILD_TYPE=${CONFIG}" -DBUILD_TESTING=ON)
    if(DEFINED GENERATOR)
        list(APPEND args -G "${GENERATOR}")
    endif()
    if(DEFINED GENERATOR_PLATFORM)
        list(APPEND args -A "${GENERATOR_PLATFORM}")
    endif()
    if(DEFINED PREFIX_PATH)
        # 经初始缓存传列表，避免 execute_process / 函数参数将分号拆成独立命令行参数。
        file(WRITE "${build}/prefix.cmake"
            "set(CMAKE_PREFIX_PATH [==[${PREFIX_PATH}]==] CACHE STRING \"CI dependency prefixes\" FORCE)\n")
        list(APPEND args -C "${build}/prefix.cmake")
    endif()
    foreach(module IN ITEMS SERIAL PCAP SIM_GIMBAL SIM_CARD)
        set(enabled OFF)
        string(TOLOWER "${module}" name)
        string(REPLACE "_" "-" name "${name}")
        if(profile STREQUAL "all" OR profile STREQUAL name)
            set(enabled ON)
        endif()
        # core 不传开关，实际检查库默认值；其他配置显式隔离已选模块。
        if(NOT profile STREQUAL "core")
            list(APPEND args "-DHANDLECORE_WITH_${module}=${enabled}")
        endif()
        set(expected_${module} "${enabled}")
    endforeach()
    run_logged("${build}/configure.log" "${CMAKE_COMMAND}" ${args})
    file(READ "${build}/CMakeCache.txt" cache)
    foreach(module IN ITEMS SERIAL PCAP SIM_GIMBAL SIM_CARD)
        if(NOT cache MATCHES "HANDLECORE_WITH_${module}:BOOL=${expected_${module}}(\n|$)")
            message(FATAL_ERROR "${profile}: unexpected ${module} selection; use a fresh build directory")
        endif()
    endforeach()
    run_logged("${build}/build.log" "${CMAKE_COMMAND}" --build "${build}" --config "${CONFIG}" --parallel "${PARALLEL}")
    run_logged("${build}/test.log" "${CMAKE_CTEST_COMMAND}" --test-dir "${build}" -C "${CONFIG}"
        --output-on-failure --output-junit "${build}/junit.xml")
    message(STATUS "${profile}: configure / build / CTest passed (${build})")
endforeach()
